# Development: leave empty — same-origin requests use the Vite dev proxy (see vite.config.js).
#
# Production (set in CI / host env at build time, any platform):
#   Netlify (netlify.toml uses /api/* → backend):  VITE_API_URL=/api
#   Reverse proxy at /api (nginx, etc.):           VITE_API_URL=/api
#   Separate API host:                             VITE_API_URL=https://api.example.com
#
# Must not share the same path prefix as React routes (e.g. do not use only /tickets as the API base).
VITE_API_URL=
