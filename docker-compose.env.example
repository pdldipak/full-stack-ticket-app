# Copy to `.env` next to docker-compose.yml (Compose loads it automatically).
# Replace every placeholder; do not commit real `.env` to git.

# MySQL (db + api containers — all required)
MYSQL_ROOT_PASSWORD=replace_with_a_strong_random_password
MYSQL_USER=tickets
MYSQL_PASSWORD=replace_with_a_strong_random_password
MYSQL_DATABASE=event_tickets

# Host port for MySQL (optional; default 3306)
MYSQL_PORT=3306

# Host port for the web UI (nginx + SPA + API proxy; default 80)
WEB_PORT=80

# JWT — use a long random string (required for Docker api service)
JWT_SECRET=change_this_to_a_long_random_string_min_32_chars_ok

# App logins (api container — required for Docker). Usernames must match sellerCities.js for sellers.
# Do not use commas inside passwords.
SELLER_USERNAMES=seller1,seller2,seller3,seller4
SELLER_PASSWORDS=replace_pass_1,replace_pass_2,replace_pass_3,replace_pass_4
SCANNER_USERNAMES=scanner1,scanner2
SCANNER_PASSWORDS=replace_scanner_1,replace_scanner_2

# Optional master admin — omit both ADMIN_* to disable.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=replace_with_strong_secret

# Comma-separated allowed origins; must match the site URL (scheme + host + port if not 80/443)
CORS_ORIGIN=http://localhost
