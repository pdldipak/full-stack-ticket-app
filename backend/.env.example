PORT=3001
NODE_ENV=development

# --- App logins (all from env; no hardcoded passwords in code) ---
# Sellers: same number of comma-separated usernames and passwords (order must match).
# Usernames must match keys in src/config/sellerCities.js (e.g. seller1,seller2,seller3,seller4).
SELLER_USERNAMES=seller1,seller2,seller3,seller4
SELLER_PASSWORDS=replace_pass_1,replace_pass_2,replace_pass_3,replace_pass_4

# Door staff (scanner UI): same count for usernames and passwords.
SCANNER_USERNAMES=scanner1,scanner2
SCANNER_PASSWORDS=replace_scanner_1,replace_scanner_2

# Optional master admin (same login page as sellers). Omit both to disable.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=replace_with_strong_secret

# MySQL — must match Docker app user if you use docker compose for db only
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tickets
DB_PASSWORD=replace_with_same_value_as_MYSQL_PASSWORD_in_root_env
DB_NAME=event_tickets

# JWT — production: at least 32 random characters
JWT_SECRET=change_this_to_a_long_random_secret_string_at_least_32_chars
JWT_EXPIRES_IN=8h

# Production: comma-separated browser origins (e.g. https://tickets.example.com)
# Development: leave unset for permissive CORS
# CORS_ORIGIN=https://tickets.example.com

# Set to 1 when the API sits behind nginx, a load balancer, or Docker reverse proxy
# TRUST_PROXY=1

# Ticket codes: TKT-{slug}-{id} e.g. TKT-NY-2083-0001. Comment out or leave empty for legacy TKT-0001 only.
TICKET_CODE_EVENT_SLUG=NY-2083
